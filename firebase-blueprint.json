{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "teacher", "sudo"] },
        "lastSeen": { "type": "string", "format": "date-time" },
        "terminalId": { "type": "string", "description": "Short public ID for connecting" }
      },
      "required": ["uid", "displayName", "role", "terminalId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global announcement from admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "authorName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "timestamp"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private message between users",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderUid": { "type": "string" },
        "receiverUid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderUid", "receiverUid", "timestamp"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "branchId": { "type": "string" }
      },
      "required": ["text", "senderUid", "timestamp", "branchId"]
    },
    "Branch": {
      "title": "Branch",
      "description": "A learning topic or chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Course": {
      "title": "Course",
      "description": "A structured learning path",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "order"]
    },
    "Module": {
      "title": "Module",
      "description": "A module within a course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "order": { "type": "number" },
        "githubLink": { "type": "string" }
      },
      "required": ["id", "courseId", "title", "order"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A quiz for a module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "number" }
            }
          }
        }
      },
      "required": ["id", "moduleId", "questions"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Tracks user progress in courses",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "courseId": { "type": "string" },
        "completedModules": { "type": "array", "items": { "type": "string" } },
        "quizScores": { "type": "object" },
        "currentModuleId": { "type": "string" },
        "certificateIssued": { "type": "boolean" },
        "certificateDate": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "courseId"]
    },
    "AiTutoringSession": {
      "title": "AiTutoringSession",
      "description": "A dedicated AI tutoring session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "branchId": { "type": "string" },
        "topic": { "type": "string" },
        "title": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "branchId"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Learning topics"
    },
    "/branches/{branchId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a branch"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Learning courses"
    },
    "/courses/{courseId}/modules/{moduleId}": {
      "schema": "Module",
      "description": "Modules in a course"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Quizzes for modules"
    },
    "/userProgress/{progressId}": {
      "schema": "UserProgress",
      "description": "User learning progress"
    },
    "/aiTutoringSessions/{sessionId}": {
      "schema": "AiTutoringSession",
      "description": "AI tutoring logs"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global admin announcements"
    },
    "/directMessages/{dmId}": {
      "schema": "DirectMessage",
      "description": "Private user chats"
    }
  }
}
