rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (required)
    //   - photoURL: string (optional)
    //   - role: string (required, 'user' | 'sudo')
    //   - lastSeen: timestamp (optional)
    //
    // Collection: branches
    // Document ID: {branchId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - description: string (optional)
    //   - createdBy: string (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: branches/{branchId}/messages
    // Document ID: {messageId}
    // Fields:
    //   - text: string (required)
    //   - senderUid: string (required)
    //   - senderName: string (required)
    //   - senderRole: string (required)
    //   - timestamp: timestamp (required)
    //   - branchId: string (required)
    //
    // Collection: userProgress
    // Document ID: {uid}_{courseId}
    // Fields:
    //   - uid: string (required)
    //   - courseId: string (required)
    //   - completedModules: list (required)
    //   - quizScores: map (required)
    //   - currentModuleId: string (optional)
    //   - certificateIssued: bool (optional)
    //   - certificateDate: timestamp (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sudo') ||
        (request.auth.token.email.lower() == "isrealadesina3@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher') || 
        isAdmin()
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'terminalId']) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.role in ['user', 'teacher', 'sudo'] &&
             data.terminalId is string;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['text', 'timestamp']) &&
             data.text is string && data.text.size() > 0 && data.text.size() < 1000;
    }

    function isValidDM(data) {
      return data.keys().hasAll(['text', 'senderUid', 'receiverUid', 'timestamp']) &&
             data.text is string && data.text.size() > 0 && data.text.size() < 2000 &&
             data.senderUid == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'senderUid', 'senderName', 'senderRole', 'timestamp', 'branchId']) &&
             data.text is string && data.text.size() > 0 && data.text.size() < 5000 &&
             data.senderUid == request.auth.uid &&
             data.senderName is string &&
             data.senderRole is string &&
             data.timestamp is timestamp &&
             data.branchId is string;
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['uid', 'courseId', 'completedModules', 'quizScores']) &&
             data.uid == request.auth.uid &&
             data.courseId is string &&
             data.completedModules is list &&
             data.quizScores is map &&
             (!('certificateIssued' in data) || data.certificateIssued is bool) &&
             (!('certificateDate' in data) || data.certificateDate is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                      (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) &&
                      (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /directMessages/{id} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid);
      allow create: if isAuthenticated() && isValidDM(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidBranch(request.resource.data) && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidMessage(request.resource.data);
        allow update: if false; // Messages are immutable for now
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.senderUid || isAdmin());
      }
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher();
      }
    }

    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || request.auth.uid == resource.data.uid);
      allow create: if isAuthenticated() && isValidUserProgress(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid)) && isValidUserProgress(request.resource.data);
    }

    match /aiTutoringSessions/{sessionId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || request.auth.uid == resource.data.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow delete: if isAuthenticated() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
    }

    match /test/connection {
      allow read: if isAuthenticated();
    }
  }
}
